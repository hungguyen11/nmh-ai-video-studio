# NMH AI Video Studio — BẢN CHÍNH THỨC (Production)
# Copy file này thành .env.local và điền key thật. Không bao giờ commit .env.local lên GitHub.
# Tất cả key chỉ ở server, frontend không bao giờ thấy.

# Chế độ: live = dùng API thật, demo = fallback miễn phí
NEXT_PUBLIC_AI_MODE=live

# --- GOOGLE (chính) ---
# Lấy tại https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Hoặc Vertex AI
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# Google Cloud TTS (nếu dùng)
GOOGLE_TTS_API_KEY=

# --- OPENAI (script, image DALL-E, TTS) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- ANTHROPIC (tuỳ chọn, Claude cho script) ---
ANTHROPIC_API_KEY=

# --- REPLICATE (SDXL, SD Video, Luma) ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- STABILITY AI (SDXL, Stable Video Diffusion) ---
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- ELEVENLABS (giọng đọc cao cấp) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- HUGGINGFACE (fallback miễn phí) ---
HUGGINGFACE_API_KEY=

# --- DATABASE (Production: Postgres) ---
# Neon / Supabase / Vercel Postgres
DATABASE_URL=postgresql://user:pass@localhost:5432/nmh_studio

# --- AUTH ---
NEXTAUTH_SECRET=thay-bang-random-32-ky-tu
NEXTAUTH_URL=https://nmh-ai-video-studio.vercel.app
# Google OAuth (để đăng nhập bằng Google — khuyến nghị)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- STORAGE (ảnh/video kết xuất) ---
# Vercel Blob / S3 / GCS
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nmh-studio
S3_REGION=ap-southeast-1

# --- FFMPEG (server) ---
FFMPEG_PATH=/usr/bin/ffmpeg
